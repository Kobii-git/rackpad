# Rackpad native-LXC environment contract. The Phase 2 installer will copy
# this versioned template to /etc/rackpad/rackpad.env without overwriting
# operator-managed values during updates.

# Native runtime and persistent-data paths
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/opt/rackpad_data/rackpad.db
RACKPAD_NATIVE_BACKUP_DIR=/opt/rackpad_data/backups

# Background health-check and synchronization intervals in milliseconds
MONITOR_INTERVAL_MS=300000
DISCOVERY_SCAN_SCHEDULE_INTERVAL_MS=60000
DOCKER_STATUS_SYNC_INTERVAL_MS=300000

# Reverse-proxy and browser-origin controls
TRUST_PROXY=0
TRUSTED_HOSTS=
TRUSTED_ORIGINS=

# API rate limiting
RACKPAD_RATE_LIMIT_DISABLED=0
RACKPAD_RATE_LIMIT_MAX=600
RACKPAD_RATE_LIMIT_WINDOW=1 minute

# Optional OIDC sign-in
OIDC_ENABLED=0
APP_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_LABEL=OIDC
OIDC_DEFAULT_ROLE=viewer
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_ROLE_CLAIM=groups
OIDC_ALLOWED_DOMAINS=
OIDC_DEBUG=0
OIDC_ADMIN_USERS=
OIDC_EDITOR_USERS=
OIDC_VIEWER_USERS=
OIDC_ADMIN_GROUPS=
OIDC_EDITOR_GROUPS=
OIDC_VIEWER_GROUPS=

# Discovery defaults. Native LXC starts with neighbor-cache discovery because
# raw-network tooling requires an explicit advanced-mode opt-in.
OUI_AUTO_UPDATE=1
DISCOVERY_MAC_SCAN_MODE=neighbor
DISCOVERY_SCAN_MAX_ACTIVE=2
DISCOVERY_SCAN_MAX_ACTIVE_PER_LAB=1
DISCOVERY_SCAN_MAX_QUEUED=32
INTEGRATION_STATUS_SYNC_INTERVAL_MS=300000

# Generate RACKPAD_SECRET_KEY during installation; never commit a real value.
RACKPAD_SECRET_KEY=

# SNMP inventory and traps. Native LXC leaves traps disabled until an operator
# explicitly enables the listener and the required firewall path.
SNMP_INVENTORY_SYNC=0
SNMP_TRAP_ENABLED=0
SNMP_TRAP_PORT=1162
SNMP_TRAP_BIND=0.0.0.0
