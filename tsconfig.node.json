{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tsbuild/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/tsconfig.node",
    "strict": true
  },
  "include": ["vite.config.ts", "server/security-headers.ts"]
}
