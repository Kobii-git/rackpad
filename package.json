{
  "name": "rackpad",
  "version": "1.8.2-dev.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Self-hosted homelab and lab inventory: racks, ports, cables, IPs, devices.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n vite,api -c cyan,yellow \"npm run dev\" \"npm run dev:server\"",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "restore:native": "node dist-server/cli/restore-native-backup.js",
    "typecheck:client": "tsc --project tsconfig.json --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server && npm run typecheck:tests",
    "test:server": "node --import tsx --test --test-concurrency=1 server/tests/**/*.test.ts",
    "test:client": "node --import tsx --test src/lib/*.test.ts src/pages/visualizer/*.test.ts",
    "test:e2e": "playwright test",
    "screenshots:update": "playwright test --config=playwright.screenshots.config.ts",
    "screenshots:check": "node scripts/check-screenshots.mjs",
    "test": "npm run test:server && npm run test:client",
    "test:full": "npm run test && npm run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "lint:proof": "node scripts/check-lint-gate.mjs",
    "check:i18n": "node --test scripts/i18n-value-rules.test.mjs && node scripts/check-i18n-values.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:config": "node scripts/check-env-contract.mjs && node scripts/check-dockerignore.mjs",
    "check:docs": "node --test scripts/check-ai-docs.test.mjs && node scripts/check-ai-docs.mjs",
    "check": "npm run lint && npm run lint:proof && npm run typecheck && npm run check:i18n && npm run test && npm run check:config && npm run check:docs && npm run build && npm run check:bundle",
    "check:full": "npm run check && npm run test:e2e",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.1.1",
    "re2-wasm": "^1.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
