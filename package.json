{
  "name": "rackpad",
  "version": "1.8.0-dev.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Self-hosted homelab and lab inventory: racks, ports, cables, IPs, devices.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n vite,api -c cyan,yellow \"npm run dev\" \"npm run dev:server\"",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "restore:native": "node dist-server/cli/restore-native-backup.js",
    "typecheck:client": "tsc --project tsconfig.json --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server && npm run typecheck:tests",
    "test:server": "node --import tsx --test --test-concurrency=1 server/tests/**/*.test.ts",
    "test:client": "node --import tsx --test src/lib/*.test.ts src/pages/visualizer/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:server && npm run test:client",
    "test:full": "npm run test && npm run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "lint:proof": "node scripts/check-lint-gate.mjs",
    "check:i18n": "node --test scripts/i18n-value-rules.test.mjs && node scripts/check-i18n-values.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:config": "node scripts/check-env-contract.mjs && node scripts/check-dockerignore.mjs",
    "check:docs": "node scripts/check-ai-docs.mjs",
    "check": "npm run lint && npm run lint:proof && npm run typecheck && npm run check:i18n && npm run test && npm run check:config && npm run check:docs && npm run build && npm run check:bundle",
    "check:full": "npm run check && npm run test:e2e",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.11.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nodemailer": "^9.0.5",
    "pino-pretty": "^13.1.1",
    "re2-wasm": "^1.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
